{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "honorificSuffix": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "about": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "nationality": {
      "type": "string"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "rather-not-say"
      ]
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "properties": {
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counter": {
          "type": "boolean"
        }
      },
      "required": [
        "keywords"
      ],
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "properties": {
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "email",
                  "github",
                  "linkedin",
                  "twitter",
                  "x",
                  "instagram",
                  "facebook",
                  "custom"
                ]
              },
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "links"
      ],
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "education",
              "experience",
              "project",
              "award",
              "custom"
            ]
          },
          "detailsLabel": {
            "type": "string"
          },
          "limit": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "timeline"
                    },
                    "period": {
                      "type": "string"
                    },
                    "location": {
                      "type": "string"
                    },
                    "details": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "style": {
                            "type": "string",
                            "enum": [
                              "list",
                              "bullet"
                            ]
                          }
                        },
                        "required": [
                          "title",
                          "description"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "link": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "slug",
                    "title",
                    "subtitle",
                    "type",
                    "period"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "list"
                    }
                  },
                  "required": [
                    "slug",
                    "title",
                    "subtitle",
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "showcase"
                    },
                    "images": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "url"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "link": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "technologies": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "active",
                        "archived",
                        "development"
                      ]
                    },
                    "featured": {
                      "type": "boolean"
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "github",
                              "demo",
                              "website",
                              "docs"
                            ]
                          },
                          "url": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "url"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "slug",
                    "title",
                    "subtitle",
                    "type",
                    "images",
                    "link",
                    "description"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "items"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "url",
    "name",
    "meta",
    "contact",
    "sections"
  ],
  "additionalProperties": false,
  "title": "Resume",
  "description": "Portfolio resume data schema (version 1.0.0)"
}
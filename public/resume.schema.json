{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "honorificSuffix": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "about": {
      "description": "One or two sentences, ≤160 characters; used for search and social previews",
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "nationality": {
      "type": "string"
    },
    "gender": {
      "type": "string",
      "enum": ["male", "female", "rather-not-say"]
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "properties": {
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counter": {
          "type": "boolean"
        },
        "legal": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": ["label", "url"]
          }
        }
      },
      "required": ["keywords"]
    },
    "contact": {
      "type": "object",
      "properties": {
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "email",
                  "github",
                  "linkedin",
                  "twitter",
                  "x",
                  "instagram",
                  "facebook",
                  "telegram",
                  "custom"
                ]
              },
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": ["type", "value"]
          }
        }
      },
      "required": ["links"]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["education", "experience", "project", "award", "custom"]
          },
          "limit": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "timeline"
                    },
                    "period": {
                      "type": "string"
                    },
                    "location": {
                      "type": "string"
                    },
                    "details": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "style": {
                            "type": "string",
                            "enum": ["list", "bullet"]
                          }
                        },
                        "required": ["title", "description"]
                      }
                    },
                    "link": {
                      "type": "string"
                    }
                  },
                  "required": ["slug", "title", "subtitle", "type", "period"]
                },
                {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "list"
                    }
                  },
                  "required": ["slug", "title", "subtitle", "type"]
                },
                {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "showcase"
                    },
                    "images": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          }
                        },
                        "required": ["url"]
                      }
                    },
                    "link": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": ["active", "archived", "development"]
                    },
                    "featured": {
                      "type": "boolean"
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": ["github", "demo", "website", "docs"]
                          },
                          "url": {
                            "type": "string"
                          }
                        },
                        "required": ["type", "url"]
                      }
                    }
                  },
                  "required": [
                    "slug",
                    "title",
                    "subtitle",
                    "type",
                    "link",
                    "description"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "summary"
                    },
                    "content": {
                      "type": "string"
                    }
                  },
                  "required": ["slug", "type", "content"]
                }
              ]
            }
          }
        },
        "required": ["id", "title", "items"]
      }
    }
  },
  "required": ["version", "url", "name", "meta", "contact", "sections"],
  "title": "Resume",
  "description": "Portfolio resume data schema (version 1.1.0)"
}

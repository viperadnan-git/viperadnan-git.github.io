{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "about": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "properties": {
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "keywords"
      ]
    },
    "contact": {
      "type": "object",
      "properties": {
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "email",
                  "github",
                  "linkedin"
                ]
              },
              "url": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "url",
              "label"
            ]
          }
        }
      },
      "required": [
        "links"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "detailsLabel": {
            "type": "string"
          },
          "limit": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "type": {
                      "const": "timeline"
                    },
                    "period": {
                      "type": "string"
                    },
                    "location": {
                      "type": "string"
                    },
                    "details": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "style": {
                            "enum": [
                              "list",
                              "bullet"
                            ]
                          }
                        },
                        "required": [
                          "title",
                          "description"
                        ]
                      }
                    },
                    "link": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "slug",
                    "title",
                    "subtitle",
                    "type",
                    "period"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "type": {
                      "const": "list"
                    }
                  },
                  "required": [
                    "slug",
                    "title",
                    "subtitle",
                    "type"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "subtitle": {
                      "type": "string"
                    },
                    "type": {
                      "const": "showcase"
                    },
                    "images": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "link": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "technologies": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "status": {
                      "enum": [
                        "active",
                        "archived",
                        "development"
                      ]
                    },
                    "featured": {
                      "type": "boolean"
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "enum": [
                              "github",
                              "demo",
                              "website",
                              "docs"
                            ]
                          },
                          "url": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "url"
                        ]
                      }
                    }
                  },
                  "required": [
                    "slug",
                    "title",
                    "subtitle",
                    "type",
                    "images",
                    "link",
                    "description"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "items"
        ]
      }
    }
  },
  "required": [
    "version",
    "name",
    "meta",
    "contact",
    "sections"
  ],
  "title": "Resume",
  "description": "Portfolio resume data schema (version 1.0.0)"
}
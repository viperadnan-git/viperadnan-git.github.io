{
  "name": "portfolio",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "bun run generate:schema && bun run generate:llms",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "generate:schema": "bun run scripts/generate-schema.ts",
    "generate:llms": "bun run scripts/generate-llms-txt.ts",
    "upgrade": "bunx next upgrade && bun update",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.525.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  },
  "nizm": {
    "hooks": {
      "biome": {
        "cmd": "bun run lint:fix {staged_files}",
        "glob": "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css}"
      }
    }
  }
}
